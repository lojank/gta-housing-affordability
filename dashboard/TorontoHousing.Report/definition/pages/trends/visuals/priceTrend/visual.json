{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "priceTrend",
  "position": {
    "x": 20,
    "y": 80,
    "z": 1000,
    "height": 300,
    "width": 820,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "affordability"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "affordability.month_start",
              "nativeQueryRef": "month_start",
              "active": true,
              "displayName": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "affordability"
                        }
                      },
                      "Property": "price_index"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(affordability.price_index)",
              "nativeQueryRef": "Average of price_index",
              "displayName": "Nominal"
            },
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "affordability"
                        }
                      },
                      "Property": "real_price_index"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(affordability.real_price_index)",
              "nativeQueryRef": "Average of real_price_index",
              "displayName": "Inflation-adjusted"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'New-home price index (Dec 2016 = 100)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}