        "lineageTag": "a0f29d81-6bb2-431d-a5ee-e1ec7690ef49",
        "measures": [
          {
            "name": "Data As Of",
            "expression": "\"Data as of \" & FORMAT ( MAX ( affordability[month_start] ), \"mmmm yyyy\" )",
            "lineageTag": "57828d44-e6c4-4cd8-be71-75c3625494ac"
          },
          {
            "name": "Latest Price Index",
            "displayFolder": "Latest",
            "expression": "LASTNONBLANKVALUE ( affordability[month_start], MAX ( affordability[price_index] ) )",
            "formatString": "0.0",
            "lineageTag": "0070e90b-7ec4-4e52-8572-523201b56a24"
          },
          {
            "name": "Price Change From Peak",
            "displayFolder": "Latest",
            "expression": "DIVIDE ( [Latest Price Index], CALCULATE ( MAX ( affordability[price_index] ), ALL ( affordability ) ) ) - 1",
            "formatString": "0.0%",
            "lineageTag": "7e1f09d7-fabe-4bdc-a592-acd777fc3e92"
          },
          {
            "name": "Latest Affordability Index",
            "displayFolder": "Latest",
            "expression": "LASTNONBLANKVALUE ( affordability[month_start], MAX ( affordability[affordability_index] ) )",
            "formatString": "0.0",
            "lineageTag": "22545d35-160f-403c-adcf-1249960d2b2c"
          },
          {
            "name": "Latest Payment per 100k",
            "displayFolder": "Latest",
            "expression": "LASTNONBLANKVALUE ( affordability[month_start], MAX ( affordability[payment_per_100k] ) )",
            "formatString": "$#,0",
            "lineageTag": "6113c970-83d4-4e8e-a63f-cce8a9b18962"
          },
          {
            "name": "Latest Mortgage Rate",
            "displayFolder": "Latest",
            "expression": "LASTNONBLANKVALUE ( affordability[month_start], MAX ( affordability[mortgage_rate_5y] ) ) / 100",
            "formatString": "0.00%",
            "lineageTag": "ad98e2ab-05c2-4ef4-8b11-9d414d0ff09a"
          },
          {
            "name": "Latest Rent to Income",
            "displayFolder": "Latest",
            "expression": "LASTNONBLANKVALUE ( affordability[month_start], MAX ( affordability[rent_to_income] ) )",
            "formatString": "0.0%",
            "lineageTag": "8525e8ae-a059-4426-a021-3ff658c3fa62"
          },
          {
            "name": "Loan Amount",
            "displayFolder": "What-if",
            "expression": "[Home Price Value] * ( 1 - [Down Payment Value] / 100 )",
            "formatString": "$#,0",
            "lineageTag": "34e1eb8d-fec0-4e10-a1f7-832b2fcff295"
          },
          {
            "name": "Monthly Payment",
            "displayFolder": "What-if",
            "expression": [
              "VAR i = POWER ( 1 + [Interest Rate Value] / 200, 1 / 6 ) - 1",
              "VAR n = [Amortization Value] * 12",
              "RETURN [Loan Amount] * i / ( 1 - POWER ( 1 + i, -n ) )"
            ],
            "formatString": "$#,0.00",
            "lineageTag": "5c186cd1-c057-4fd3-86d8-149583162e12"
          },
          {
            "name": "Share of Income",
            "displayFolder": "What-if",
            "expression": "DIVIDE ( [Monthly Payment], [Household Income Value] / 12 )",
            "formatString": "0.0%",
            "lineageTag": "04ae1e80-066c-4ea9-8333-cb1aa7f55f4c"
          }
        ],
        "partitions": [
          {
            "name": "affordability",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectFolder & \"\\exports\\affordability.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Headers, {}, each if _ = \"\" then null else _),",
                "    Typed = Table.TransformColumnTypes(Blanks, {",
                "        {\"month\", type text},",
                "        {\"month_start\", type date},",
                "        {\"year\", Int64.Type},",
                "        {\"rate_period\", type text},",
                "        {\"is_estimated\", Int64.Type},",
                "        {\"estimated_notes\", type text},",
                "        {\"price_index\", type number},",
                "        {\"real_price_index\", type number},",
                "        {\"cpi\", type number},",
                "        {\"rent_2br\", type number},",
                "        {\"income_nominal\", type number},",
                "        {\"policy_rate\", type number},",
                "        {\"mortgage_rate_5y\", type number},",
                "        {\"payment_per_100k\", type number},",
                "        {\"affordability_index\", type number},",
                "        {\"rent_to_income\", type number},",
                "        {\"price_yoy_pct\", type number},",
                "        {\"rent_yoy_pct\", type number},",
                "        {\"affordability_yoy_pct\", type number}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
